# ==============================================================================
# Plantilla de Variables de Entorno — Aplicación Musical con Chatbot Gemini
# ==============================================================================
# IMPORTANTE: Copia este archivo como .env y coloca tu API Key de Gemini.
# NUNCA subas el archivo .env real al repositorio de Git.

# Credencial de API de Google Gemini (Google AI Studio)
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Nombre del modelo de IA activo
GEMINI_MODEL=gemini-2.5-flash

# URL base de la API de Google Gemini (v1beta)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Entorno de ejecución: 'development' | 'test' | 'production'
APP_ENV=development

# Puerto para el servidor backend proxy local
PORT=3001

# Tiempo máximo de espera para solicitudes a la IA (en milisegundos)
REQUEST_TIMEOUT_MS=15000
